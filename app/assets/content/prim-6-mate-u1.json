        {
          "id": "e1",
          "tipo": "opcion_multiple",
          "pregunta": "¿Qué fracción está sombreada?",
          "imagen": "images/fraccion1.png",
          "opciones": ["1/2", "1/3", "2/3", "3/4"],
          "correcta": 0,
          "explicacion": "Hay 1 parte sombreada de 2 totales."
        },
        {
          "id": "e2",
          "tipo": "opcion_multiple",
          "pregunta": "Si divides una tortilla en 4 partes iguales y tomas 3, ¿qué fracción tomaste?",
          "opciones": ["1/4", "3/4", "4/3", "1/3"],
          "correcta": 1,
          "explicacion": "Tomaste 3 de las 4 partes: 3/4."
        }
      ]
    },
    {
      "id": "l2",
      "titulo": "Fracciones equivalentes",
      "orden": 2,
      "video": "media/prim-6-mate-u1-l2.mp4",
      "duracionSeg": 300,
      "guionDocente": "docs/contenido/prim-6-mate-u1-l2.md",
      "autor": "Profa. Ana López",
      "validadoPor": "Coord. Académica",
      "texto": "Dos fracciones son equivalentes si representan la misma cantidad, aunque se escriban distinto: 1/2 = 2/4 = 4/8.",
      "ejercicios": [
        {
          "id": "e3",
          "tipo": "opcion_multiple",
          "pregunta": "¿Cuál fracción es equivalente a 1/2?",
          "opciones": ["2/4", "1/3", "3/5", "2/3"],
          "correcta": 0,
          "explicacion": "2/4 se obtiene al multiplicar numerador y denominador por 2."
        }
      ]
    }
