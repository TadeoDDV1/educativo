    {
      "id": "prim-2-sabe-u1-l1",
      "titulo": "Sumar la misma cantidad",
      "orden": 1,
      "video": null,
      "texto": "Cuando sumamos la misma cantidad varias veces, podemos multiplicar. 3 canastas con 4 naranjas cada una son 4 + 4 + 4 = 12, que también se escribe 3 × 4 = 12. Repartir en partes iguales es dividir: 10 dulces entre 2 amigos tocan a 5 cada uno.",
      "ejercicios": [
        {
          "id": "e1",
          "tipo": "opcion_multiple",
          "pregunta": "Hay 3 canastas con 4 naranjas cada una. ¿Cuántas naranjas hay?",
          "opciones": [
            "7",
            "12",
            "34",
            "10"
          ],
          "correcta": 1,
          "explicacion": "4 + 4 + 4 = 12, o sea 3 × 4 = 12."
        },
        {
          "id": "e2",
          "tipo": "opcion_multiple",
          "pregunta": "4 + 4 + 4 se puede escribir como…",
          "opciones": [
            "4 + 3",
            "3 × 4",
            "4 − 3",
            "43"
          ],
          "correcta": 1,
          "explicacion": "Sumar tres veces el 4 es 3 × 4."
        },
        {
          "id": "e3",
          "tipo": "opcion_multiple",
          "pregunta": "Repartes 10 dulces entre 2 amigos por igual. ¿Cuántos le tocan a cada uno?",
          "opciones": [
            "5",
            "8",
            "12",
            "20"
          ],
          "correcta": 0,
          "explicacion": "10 repartido entre 2 es 5."
        },
        {
          "id": "e4",
          "tipo": "opcion_multiple",
          "pregunta": "2 × 5 = ___",
          "opciones": [
            "7",
            "25",
            "10",
            "3"
          ],
          "correcta": 2,
          "explicacion": "2 × 5 es 5 + 5 = 10."
        }
      ]
    },
    {
