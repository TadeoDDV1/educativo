            "21",
            "9"
          ],
          "correcta": 0,
          "explicacion": "18 ÷ 3 = 6 equipos."
        },
        {
          "id": "e4",
          "tipo": "opcion_multiple",
          "pregunta": "40 ÷ 8 = ___",
